# 页面标题
VITE_APP_TITLE=知识库管理
# 接口前缀：dev 走 vite 代理并剥掉 /kb-api 前缀转发给后端；
# 生产由 nginx 反代 /kb-api 到后端（与正式环境同一前缀，行为一致）
VITE_APP_BASE_API=/kb-api
# dev 代理的后端地址；本地起后端（uvicorn 默认 8000 端口）时保持此值即可
VITE_PROXY_TARGET=http://127.0.0.1:8000
# 认证模式（issue #37）：本地开发免登录直通（后端 AUTH_MODE=off 对应）。
# 需要在本地调 SSO 链路时改为 unified 并补 VITE_IDENTITY_LOGIN_URL。
VITE_AUTH_MODE=off
