{
  "name": "kb-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:pack": "vue-tsc --noEmit && vite build && tar -czf dist.tar.gz dist && node -e \"require('fs').rmSync('dist',{recursive:true})\"",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "element-plus": "^2.8.8",
    "json-bigint": "^1.0.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.15.0",
    "sass": "^1.79.5",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.10",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
