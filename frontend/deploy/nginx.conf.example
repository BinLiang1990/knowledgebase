# 独立域名/根路径部署时用这份，复制到服务器的 /etc/nginx/conf.d/kb-frontend.conf，
# 改好 server_name / root 之后 `nginx -t && systemctl reload nginx`。
#
# 如果服务器上 nginx 已经跑着别的站点，server_name 别再写 "_"（通配）——会跟已有的
# 通配 server 冲突，改成实际域名或者服务器 IP。
#
# 前端已迁移为 hash 路由 + 相对 base（见 运维.md「三、路由与部署路径」）：
# - 不再需要 try_files 回退——客户端路由在 # 后面，刷新/直链请求的永远是 index.html；
# - 同一份 dist 可以挂根路径也可以挂任意子路径（alias），不需要按路径重新 build。
server {
    listen 80;
    server_name _;

    root /opt/kb-frontend/dist;
    index index.html;

    location / {
    }

    # 接口反向代理：前端请求同域的 /kb-api/...，剥前缀转发给后端
    # （proxy_pass 末尾的斜杠就是"剥前缀"；端口按实际后端改）
    location /kb-api/ {
        proxy_pass http://127.0.0.1:7071/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

# 子路径部署（当前正式环境 platform-enterprise.yicall.com 实际用的是这种）：
# 前端跟别的应用共用同一个 server/域名，挂在 /kb-web 下面。相对 base 的产物
# 天然支持 alias 子路径，无需任何构建参数配合。
# location /kb-web {
#     alias /web/KnowledgeBaseWeb;
#     index index.html;
# }
