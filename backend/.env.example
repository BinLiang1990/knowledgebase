# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=knowledgebase

# ---- 测试目标库（必配，否则 pytest 拒绝启动） ----
# 测试套件会对目标库 downgrade base（drop 全部表）再重建，库里既有数据每跑
# 一次清一次。必须显式指定 TEST_DB_NAME；名字含 "pro" 的库（正式环境
# knowledgebase_pro）一律拒绝。TEST_DB_HOST/PORT/USER/PASSWORD 留空 =
# 沿用上面 DB_* 的连接参数。详见 tests/conftest.py 顶部说明。
# 当前环境约定：RDS 上 knowledgebase 即测试环境，knowledgebase_pro 是正式环境。
TEST_DB_NAME=knowledgebase
# TEST_DB_HOST=
# TEST_DB_PORT=
# TEST_DB_USER=
# TEST_DB_PASSWORD=

# Origins allowed to call this API cross-origin (comma-separated). Default
# already covers the frontend's Vite dev server (issue #6); only override
# if the frontend runs somewhere else.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Production behind the platform-enterprise.yicall.com gateway: the gateway's
# nginx reverse-proxies /kb-api to this app on the same host (see
# Docker部署.md / 运维.md「挂在 /kb-api 子路径下」), so the frontend
# (served from /kb-web under the same origin) and this API share one origin —
# the browser never sends a cross-origin request, so CORS isn't actually in
# the request path. Still worth setting for direct/local testing against the
# real domain:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://platform-enterprise.yicall.com

# ---- 统一身份认证（issue #36，手册《Python-Vue项目统一身份认证平台对接实施手册》§4） ----
# AUTH_MODE=off（默认）：免登录直通，本地开发用；unified：正式环境 SSO。
# 登记参数向统一平台方申请，禁止自行猜测（手册 §2）。
# IDENTITY_CLIENT_SECRET 是明文 HMAC 密钥：只放服务器 .env，绝不提交仓库/
# 进前端/进日志。
# AUTH_MODE=unified
# AUTH_SYSTEM_CODE=your-system-code
# AUTH_ACCEPTED_TICKET_TYPES=SAME_DOMAIN
# IDENTITY_BASE_URL=https://platform-identity.yicall.com
# IDENTITY_CLIENT_ID=your-client-id
# IDENTITY_CLIENT_SECRET=change_me
# IDENTITY_APP_TYPE=ADMIN
# IDENTITY_SSO_TIMEOUT=10
# AUTH_CACHE_TTL_SECONDS=60
#
# 基准版 §5 只读对接面的过渡期免鉴权开关（默认 true=免鉴权，契约现状）。
# 与对接方（bqxt）书面约定切换日期后改为 false：只读面纳入服务 Token 强制
# 校验，未携带有效 X-Service-Token 的请求一律 401（对接方须已完成服务 Token
# 对接）。只影响第三方只读面，运营前端登录态不受影响。改完重启即生效。
# THIRD_PARTY_EXEMPT_ENABLED=true

# ---- 万能只读 Token（自管静态凭证，与统一平台无关） ----
# 请求头 X-Readonly-Token 与此值匹配即以 viewer 只读身份放行全部查询接口
# （GET/HEAD；/users 等 sysadmin 面除外），写操作一律 403。空（默认）=关闭。
# 生成建议：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 明文凭证：只放服务器 .env，绝不提交仓库/进前端代码/进日志。
# READONLY_TOKEN=change_me
